---
import SourceBadge from './SourceBadge.astro';
import type { RankingComputation } from '../data/utils/ranking-scoring';

interface Props {
  entries: RankingComputation[];
}

const { entries } = Astro.props;

// 本站开始收录该服务商至今的天数——不是"该服务商稳定运营 X 天"，只是
// "本站已经跟踪这家服务商多久"，两者不能混淆表述。用真实的 createdAt
// 计算，不是编造数字。
function daysTracked(trackedSince: string): number {
  const start = new Date(trackedSince).getTime();
  const now = Date.now();
  return Math.max(0, Math.floor((now - start) / (1000 * 60 * 60 * 24)));
}
---

{
  entries.length > 0 ? (
    <ol class="ranking-list">
      {entries.map((entry) => (
        <li class={`ranking-list__item${entry.finalRank === 1 ? ' ranking-list__item--top' : ''}`}>
          {entry.finalRank === 1 && (
            <div class="ranking-list__top-banner">
              <span class="ranking-list__top-badge">👑 站群统一首推 · 综合第一名</span>
              <span class="ranking-list__top-pill">低至 ¥6.6/月（MINI档）</span>
              <span class="ranking-list__top-pill">全协议支持 · 资费全公开</span>
            </div>
          )}
          <div class="ranking-list__header">
            <span class="ranking-list__rank">
              <span class="sr-only">第</span>
              {entry.finalRank === 1 ? '👑' : entry.finalRank}
              <span class="sr-only">名</span>
            </span>
            <a
              href={`/airports/${entry.providerSlug}/`}
              data-analytics-event="recommendation_card_click"
              data-provider={entry.providerSlug}
              data-provider-name={entry.providerName}
              data-cta-label={`排名第${entry.finalRank}名`}
            >
              {entry.providerName}
            </a>
            <span class="ranking-list__tracked">本站已跟踪 {daysTracked(entry.trackedSince)} 天</span>
          </div>
          <p>{entry.reason}</p>
          {entry.baseScore !== null && (
            <dl>
              <dt>
                <SourceBadge type="calculated" />
              </dt>
              <dd>基础评分：{entry.baseScore.toFixed(1)}（{entry.metricSummary}）</dd>

              {entry.editorialAdjustment !== 0 && (
                <>
                  <dt>评分调整</dt>
                  <dd>
                    {entry.editorialAdjustment > 0 ? '+' : ''}
                    {entry.editorialAdjustment} 分
                    {entry.editorialAdjustmentReason ? `：${entry.editorialAdjustmentReason}` : ''}
                  </dd>
                </>
              )}

              {entry.finalScore !== null && (
                <>
                  <dt>最终评分</dt>
                  <dd>{entry.finalScore.toFixed(1)}</dd>
                </>
              )}
            </dl>
          )}
        </li>
      ))}
    </ol>
  ) : (
    <div class="empty-state">
      <p class="empty-state__title">当前暂无符合发布条件的服务商</p>
      <p>数据不足时我们不会为了凑数而给出排名，等有服务商满足发布门槛后会自动出现在这里。</p>
    </div>
  )
}

<style>
  .ranking-list__top-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .ranking-list__top-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(245, 158, 11, 0.35);
  }

  .ranking-list__top-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(245, 158, 11, 0.12);
    color: #d97706;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  :root[data-theme='dark'] .ranking-list__top-pill {
    background: rgba(245, 158, 11, 0.2);
    color: #fbbf24;
    border-color: rgba(245, 158, 11, 0.4);
  }

  .ranking-list__tracked {
    margin-left: auto;
    flex-shrink: 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
    white-space: nowrap;
  }
</style>
