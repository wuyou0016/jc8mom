---
import { siteConfig } from '../config/site';

const navItems = [
  { label: '首页', href: '/' },
  { label: '机场导航', href: '/airports/' },
  { label: '机场推荐', href: '/rankings/' },
  { label: '知识库', href: '/knowledge/' },
  { label: '教程', href: '/tutorials/' },
  { label: '故障排查', href: '/troubleshooting/' },
  { label: '机场评测', href: '/reviews/' },
];

const pathname = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo">
      <span class="site-header__logo-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <defs>
            <linearGradient id="logo-rocket-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#8b5cf6" />
              <stop offset="1" stop-color="#3b82f6" />
            </linearGradient>
          </defs>
          <path d="M12 2c2.8 2.4 3.6 6.4 3.6 10.4 0 1.6-.4 3.2-.8 4.4h-5.6c-.4-1.2-.8-2.8-.8-4.4C8.4 8.4 9.2 4.4 12 2Z" fill="url(#logo-rocket-grad)" />
          <circle cx="12" cy="9.6" r="1.6" fill="#fff" fill-opacity="0.9" />
          <path d="M9.2 13.6c-1.6.4-2.4 2-2.4 4 1.6-.4 3.2-1.2 3.6-2.8l-1.2-1.2ZM14.8 13.6c1.6.4 2.4 2 2.4 4-1.6-.4-3.2-1.2-3.6-2.8l1.2-1.2Z" fill="url(#logo-rocket-grad)" fill-opacity="0.6" />
          <path d="M10.8 16.8h2.4l-1 3.4a.7.7 0 0 1-1.4 0l-1-3.4Z" fill="#fbbf24" />
        </svg>
      </span>
      <span class="site-header__logo-text">
        <span class="site-header__logo-name">{siteConfig.brandName}</span>
        <span class="site-header__logo-tagline">专业的机场代理推荐与导航平台</span>
      </span>
    </a>

    <div class="site-header__actions">
      <nav aria-label="主导航" class="site-nav site-header__nav-desktop">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <details class="site-header__toggle">
        <summary aria-label="打开菜单"></summary>
        <nav aria-label="移动端导航" class="site-nav">
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>

      <button type="button" class="header-icon-btn" aria-label="搜索（即将上线）" disabled>
        <img src="/assets/icons/search.svg" alt="" width="18" height="18" aria-hidden="true" />
      </button>

      <button type="button" class="header-icon-btn theme-toggle" id="theme-toggle" aria-label="切换深色/浅色模式">
        <!-- sun.svg / moon.svg 本身是用 stroke="currentColor" 画的，设计上就是要跟随按钮的
             文字颜色变色。之前用 <img src="..."> 加载会导致 currentColor 完全失效——外部
             引用的图片是隔离文档，不会继承页面的 CSS color，所以图标一直只能显示 SVG
             自带的默认黑色描边，在暗色按钮背景上基本看不清。改成直接内联 SVG 标签，
             currentColor 才能正确取到 .theme-toggle 的 color，图标跟着主题变色。 -->
        <svg class="theme-toggle__sun" width="18" height="18" viewBox="0 0 32 32" aria-hidden="true">
          <circle cx="16" cy="16" r="5" fill="none" stroke="currentColor" stroke-width="2" />
          <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M25.2 6.8l-2.8 2.8M9.6 22.4l-2.8 2.8" />
          </g>
        </svg>
        <svg class="theme-toggle__moon" width="18" height="18" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M23.5 20.8A10.5 10.5 0 0 1 11.2 8.5 10.5 10.5 0 1 0 23.5 20.8Z" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'rj-theme';
    var btns = document.querySelectorAll('.theme-toggle');
    if (!btns.length) return;
    btns.forEach(function(btn) {
      btn.addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem(STORAGE_KEY, next);
        } catch (e) {}
      });
    });
  })();
</script>
