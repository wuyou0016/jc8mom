---
import { siteConfig } from '../config/site';

const telegramUrl = 'https://t.me/wyolink';

// 只链接已在 Information Architecture v1.1 中确定的核心结构。
// About/Contact/Privacy/Terms 尚无对应内容规划，暂不放入，避免死链。
const coreLinks = [
  { label: '首页', href: '/' },
  { label: '机场导航', href: '/airports/' },
  { label: '机场推荐', href: '/rankings/' },
  { label: '知识库', href: '/knowledge/' },
  { label: '教程', href: '/tutorials/' },
  { label: '故障排查', href: '/troubleshooting/' },
  { label: '机场评测', href: '/reviews/' },
  { label: '入驻申请', href: telegramUrl, external: true },
];

// 核心主题：对应站内最重要的几个 SEO 落点，直接指向各自的 Landing Page，
// 不制造新的关键词竞争页面。
const topicLinks = [
  { label: '机场代理', href: '/knowledge/what-is-airport-proxy/' },
  { label: '机场推荐', href: '/rankings/' },
  { label: '性价比机场', href: '/rankings/best-value/' },
  { label: '机场稳定性', href: '/rankings/most-stable/' },
  { label: '机场新手教程', href: '/tutorials/airport-beginner-full-guide/' },
];

const friendLinks = [
  { label: '机场荟 - 机场导航', href: 'https://8jc.mom' },
  { label: '99机场梯子导航', href: 'https://99jc.my' },
  { label: '99机场吧 - 翻墙推荐', href: 'https://99jc.xyz' },
  { label: '爱机场 - 机场推荐', href: 'https://ajc.lol' },
  { label: '机场推荐 - 机场宝', href: 'https://jichangbao.com' },
  { label: '翻墙机场 - 火箭机场', href: 'https://rocketjichang.com' },
  { label: '机场测评 - 机场E家', href: 'https://ejichang.com' },
  { label: '机场导航 - 机场TJ', href: 'https://jichangtj.net' },
  { label: '机场实验室', href: 'https://jichanglabs.co' },
];

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <h2>{siteConfig.brandName}</h2>
      <p>{siteConfig.description}</p>
    </div>
    <div>
      <h2>主要导航</h2>
      <ul>
        {
          coreLinks.map((item) => (
            <li>
              <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2>核心主题</h2>
      <ul>
        {
          topicLinks.map((item) => (
            <li>
              <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2>友情链接</h2>
      <ul>
        {
          friendLinks.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="container site-footer__note">
    <h2>网站说明</h2>
    <p>本站提供机场信息整理、使用知识、测试数据与编辑推荐。不同来源的数据会明确标注来源类型（官方公开信息、第三方资料、本站实测、编辑观点），不会混在一起呈现。</p>
  </div>
  <div class="container site-footer__bottom">
    <p>&copy; {currentYear} {siteConfig.brandName}（{siteConfig.brandNameEn}）</p>
    <div class="site-footer__actions">
      <a href={telegramUrl} target="_blank" rel="noopener" class="footer-apply-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="8.5" cy="7.5" r="4"/>
          <line x1="20" y1="8" x2="20" y2="14"/>
          <line x1="23" y1="11" x2="17" y2="11"/>
        </svg>
        <span>入驻申请</span>
      </a>
      <span class="site-footer__contact">
        <span class="site-footer__contact-label">联系我们</span>
        <a href={telegramUrl} target="_blank" rel="noopener" class="footer-icon-btn" aria-label="联系我们（Telegram）">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M21.05 3.64 2.98 10.7c-1.23.49-1.23 1.18-.22 1.49l4.63 1.45 1.79 5.6c.22.6.38.84.78.84.4 0 .58-.18.8-.4l1.93-1.87 4 2.96c.74.41 1.27.2 1.46-.68l2.64-12.5c.28-1.15-.42-1.66-1.79-1.15Zm-11.6 9.32-1.7-5.34 9.9-6.26c.47-.28.9-.13.54.18l-8.74 11.42Z"
            fill="currentColor"
          />
        </svg>
        </a>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer__actions {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4, 1rem);
  }
  .footer-apply-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.35rem 0.85rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-primary, #2563eb);
    background: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.25);
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .footer-apply-btn:hover {
    background: var(--color-primary, #2563eb);
    color: #fff;
    border-color: var(--color-primary, #2563eb);
    box-shadow: 0 2px 6px rgba(37, 99, 235, 0.2);
  }
  :root[data-theme='dark'] .footer-apply-btn {
    background: rgba(139, 92, 246, 0.15);
    border-color: rgba(139, 92, 246, 0.35);
    color: #c4b5fd;
  }
  :root[data-theme='dark'] .footer-apply-btn:hover {
    background: #8b5cf6;
    color: #fff;
    box-shadow: 0 2px 8px rgba(139, 92, 246, 0.3);
  }
</style>
